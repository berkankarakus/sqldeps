Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: DBeaver SQL Editor plugin template
Bundle-SymbolicName: org.example.dbeaver;singleton:=true
Bundle-Version: 0.1.0.qualifier
Bundle-Activator: org.example.dbeaver.Activator
Bundle-RequiredExecutionEnvironment: JavaSE-21
Bundle-ActivationPolicy: lazy
Require-Bundle: org.eclipse.core.runtime,
 org.eclipse.jface.text,
 org.eclipse.lsp4j;bundle-version="[0.24.0,1.1.0)",
 org.eclipse.lsp4j.jsonrpc;bundle-version="[0.24.0,1.1.0)",
 org.eclipse.ui,
 org.eclipse.ui.editors,
 org.eclipse.ui.workbench.texteditor,
 org.jkiss.dbeaver.ui.editors.sql
Automatic-Module-Name: org.example.dbeaver

