<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <extension point="org.eclipse.ui.startup">
      <startup class="org.sqldeps.dbeaver.editor.NestedSqlEditorStartup" />
   </extension>

   <extension point="org.eclipse.core.expressions.definitions">
      <definition id="org.sqldeps.dbeaver.sqlEditorBase">
         <or>
            <with variable="activeEditor">
               <instanceof value="org.jkiss.dbeaver.ui.editors.sql.SQLEditorBase" />
            </with>
            <with variable="activePart">
               <instanceof value="org.jkiss.dbeaver.ui.editors.sql.SQLEditorBase" />
            </with>
            <with variable="activeEditor">
               <adapt type="org.jkiss.dbeaver.ui.editors.sql.SQLEditorBase" />
            </with>
         </or>
      </definition>
      <definition id="org.sqldeps.dbeaver.sqlEditorNested">
         <or>
            <with variable="activeEditor">
               <instanceof value="org.jkiss.dbeaver.ui.editors.sql.SQLEditorNested" />
            </with>
            <with variable="activePart">
               <instanceof value="org.jkiss.dbeaver.ui.editors.sql.SQLEditorNested" />
            </with>
            <and>
               <with variable="activeEditor">
                  <not>
                     <instanceof value="org.jkiss.dbeaver.ui.editors.sql.SQLEditorBase" />
                  </not>
               </with>
               <with variable="activeEditor">
                  <adapt type="org.jkiss.dbeaver.ui.editors.sql.SQLEditorBase" />
               </with>
            </and>
         </or>
      </definition>
      <definition id="org.sqldeps.dbeaver.sqlEditor">
         <reference definitionId="org.sqldeps.dbeaver.sqlEditorBase" />
      </definition>
   </extension>

   <extension
         point="org.jkiss.dbeaver.sql.editorAddIns">
      <addIn
            class="org.sqldeps.dbeaver.editor.SqlEditorLspAddIn"
            id="org.sqldeps.dbeaver.sqlEditorAddIn"
            priority="500" />
   </extension>

   <extension point="org.jkiss.dbeaver.sql.quickFixProcessors">
      <quickFixProcessor
            class="org.sqldeps.dbeaver.editor.actions.SqldepsQuickFixProcessor"
            id="org.sqldeps.dbeaver.sqldepsQuickFixProcessor">
         <handledMarkerTypes id="org.jkiss.dbeaver.ui.editors.sql.databaseScriptProblemMarker" />
      </quickFixProcessor>
   </extension>

   <extension point="org.eclipse.ui.commands">
      <command
            id="org.sqldeps.dbeaver.commands.analyzeSql"
            name="Analyze SQL"
            description="Request diagnostics for the active SQL or nested source editor document" />
      <command
            id="org.sqldeps.dbeaver.commands.codeActions"
            name="Show All sqldeps Code Actions..."
            description="Show safe code actions for all diagnostics in the active SQL or nested source editor document" />
      <command
            id="org.sqldeps.dbeaver.commands.impact"
            name="Show Impact of Changing Selected Object..."
            description="Show which indexed objects are affected by changing the object under the selection or cursor" />
      <command
            id="org.sqldeps.dbeaver.commands.quickFixes"
            name="Show sqldeps Quick Fixes..."
            description="Show sqldeps code actions for the current SQL selection or diagnostic" />
      <!-- DBeaver 26.2.x hard-codes this command id for annotation hover quick fixes. -->
      <command
            id="org.eclipse.jdt.ui.edit.text.java.correction.assist.proposals"
            name="Show sqldeps Quick Fixes..."
            description="Show sqldeps code actions for the current SQL diagnostic" />
      <command
            id="org.sqldeps.dbeaver.commands.diagnostics"
            name="Show sqldeps Diagnostics"
            description="Show diagnostics for the active SQL or nested source editor document" />
      <command
            id="org.sqldeps.dbeaver.commands.nextDiagnostic"
            name="Next sqldeps Diagnostic"
            description="Navigate to the next sqldeps diagnostic" />
      <command
            id="org.sqldeps.dbeaver.commands.previousDiagnostic"
            name="Previous sqldeps Diagnostic"
            description="Navigate to the previous sqldeps diagnostic" />
      <command
            id="org.sqldeps.dbeaver.commands.selectIndex"
            name="Select sqldeps Index..."
            description="Select the SQLite index for the active SQL or nested source editor" />
      <command
            id="org.sqldeps.dbeaver.commands.automaticIndex"
            name="Use Automatic sqldeps Index"
            description="Let sqldeps select an index from the workspace context" />
      <command
            id="org.sqldeps.dbeaver.commands.reindex"
            name="Reindex sqldeps Index"
            description="Rebuild the active sqldeps index and refresh the SQL or nested source editor" />
      <command
            id="org.sqldeps.dbeaver.commands.experimentalSuggestions"
            name="Experimental Code Actions"
            description="Enable per-user experimental sqldeps code actions and code generation; previews are confirmed and active editor sessions restart">
         <state
               class="org.eclipse.ui.handlers.RegistryToggleState"
               id="org.eclipse.ui.commands.toggleState" />
      </command>
   </extension>

   <extension point="org.eclipse.ui.handlers">
      <!--
        The quick fix handlers are intentionally not scoped with activeWhen: DBeaver runs the hover quick fix
        through this command id, and scoping it made the nested source editor fail with
        "Can't execute command". DBeaver has no JDT editors, so there is nothing to hijack.
      -->
      <handler
            class="org.sqldeps.dbeaver.commands.QuickFixCommandHandler"
            commandId="org.sqldeps.dbeaver.commands.quickFixes">
      </handler>
      <handler
            class="org.sqldeps.dbeaver.commands.QuickFixCommandHandler"
            commandId="org.eclipse.jdt.ui.edit.text.java.correction.assist.proposals">
      </handler>
      <handler
            class="org.sqldeps.dbeaver.commands.ImpactHandler"
            commandId="org.sqldeps.dbeaver.commands.impact">
         <activeWhen>
            <reference definitionId="org.sqldeps.dbeaver.sqlEditorBase" />
         </activeWhen>
      </handler>
      <handler
            class="org.sqldeps.dbeaver.commands.AnalyzeSqlHandler"
            commandId="org.sqldeps.dbeaver.commands.analyzeSql">
         <activeWhen>
            <reference definitionId="org.sqldeps.dbeaver.sqlEditorBase" />
         </activeWhen>
      </handler>
      <handler
            class="org.sqldeps.dbeaver.commands.CodeActionsHandler"
            commandId="org.sqldeps.dbeaver.commands.codeActions">
         <activeWhen>
            <reference definitionId="org.sqldeps.dbeaver.sqlEditorBase" />
         </activeWhen>
      </handler>
      <handler
            class="org.sqldeps.dbeaver.commands.DiagnosticsHandler"
            commandId="org.sqldeps.dbeaver.commands.diagnostics">
         <activeWhen>
            <reference definitionId="org.sqldeps.dbeaver.sqlEditorBase" />
         </activeWhen>
      </handler>
      <handler
            class="org.sqldeps.dbeaver.commands.NextDiagnosticHandler"
            commandId="org.sqldeps.dbeaver.commands.nextDiagnostic">
         <activeWhen>
            <reference definitionId="org.sqldeps.dbeaver.sqlEditorBase" />
         </activeWhen>
      </handler>
      <handler
            class="org.sqldeps.dbeaver.commands.PreviousDiagnosticHandler"
            commandId="org.sqldeps.dbeaver.commands.previousDiagnostic">
         <activeWhen>
            <reference definitionId="org.sqldeps.dbeaver.sqlEditorBase" />
         </activeWhen>
      </handler>
      <handler
            class="org.sqldeps.dbeaver.commands.SelectIndexHandler"
            commandId="org.sqldeps.dbeaver.commands.selectIndex">
         <activeWhen>
            <reference definitionId="org.sqldeps.dbeaver.sqlEditorBase" />
         </activeWhen>
      </handler>
      <handler
            class="org.sqldeps.dbeaver.commands.AutomaticIndexHandler"
            commandId="org.sqldeps.dbeaver.commands.automaticIndex">
         <activeWhen>
            <reference definitionId="org.sqldeps.dbeaver.sqlEditorBase" />
         </activeWhen>
      </handler>
      <handler
            class="org.sqldeps.dbeaver.commands.ReindexHandler"
            commandId="org.sqldeps.dbeaver.commands.reindex">
         <activeWhen>
            <reference definitionId="org.sqldeps.dbeaver.sqlEditorBase" />
         </activeWhen>
      </handler>
      <handler
            class="org.sqldeps.dbeaver.commands.ExperimentalSuggestionsHandler"
            commandId="org.sqldeps.dbeaver.commands.experimentalSuggestions" />
   </extension>

   <extension point="org.eclipse.ui.bindings">
      <key
            commandId="org.sqldeps.dbeaver.commands.analyzeSql"
            contextId="org.eclipse.ui.contexts.window"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
            sequence="M1+M3+A" />
      <key
            commandId="org.sqldeps.dbeaver.commands.codeActions"
            contextId="org.eclipse.ui.contexts.window"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
            sequence="M1+M3+K" />
      <key
            commandId="org.sqldeps.dbeaver.commands.diagnostics"
            contextId="org.eclipse.ui.contexts.window"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
            sequence="M1+M3+L" />
   </extension>

   <extension point="org.eclipse.ui.menus">
      <!-- Nested source editors have no SQL side toolbar, so expose the same buttons on the main toolbar. -->
      <menuContribution
            allPopups="false"
            locationURI="toolbar:dbeaver-general?after=sql_tools">
         <command
               commandId="org.sqldeps.dbeaver.commands.analyzeSql"
               label="Analyze SQL"
               tooltip="Run sqldeps diagnostics"
               style="push">
            <visibleWhen>
               <reference definitionId="org.sqldeps.dbeaver.sqlEditorNested" />
            </visibleWhen>
         </command>
         <command
               commandId="org.sqldeps.dbeaver.commands.codeActions"
               label="sqldeps Code Actions"
               tooltip="Show safe sqldeps code actions"
               style="push">
            <visibleWhen>
               <reference definitionId="org.sqldeps.dbeaver.sqlEditorNested" />
            </visibleWhen>
         </command>
      </menuContribution>
      <menuContribution
            allPopups="false"
            locationURI="toolbar:org.jkiss.dbeaver.ui.editors.sql.toolbar.side.top?after=tools">
         <command
               commandId="org.sqldeps.dbeaver.commands.analyzeSql"
               label="Analyze SQL"
               tooltip="Run sqldeps diagnostics"
               style="push" />
         <command
               commandId="org.sqldeps.dbeaver.commands.codeActions"
               label="sqldeps Code Actions"
               tooltip="Show safe sqldeps code actions"
               style="push" />
         <command
               commandId="org.sqldeps.dbeaver.commands.diagnostics"
               label="sqldeps Diagnostics"
               tooltip="Show sqldeps diagnostics"
               style="push" />
      </menuContribution>
      <menuContribution locationURI="menu:org.eclipse.ui.main.menu?after=additions">
         <menu id="org.sqldeps.dbeaver.menu" label="sqldeps">
            <command
                  commandId="org.sqldeps.dbeaver.commands.analyzeSql"
                  label="Analyze SQL"
                  style="push" />
            <command
                  commandId="org.sqldeps.dbeaver.commands.codeActions"
                  label="Show All sqldeps Code Actions..."
                  style="push" />
            <command
                  commandId="org.sqldeps.dbeaver.commands.quickFixes"
                  label="Show sqldeps Quick Fixes..."
                  style="push" />
            <command
                  commandId="org.sqldeps.dbeaver.commands.diagnostics"
                  label="Show sqldeps Diagnostics"
                  style="push" />
            <command
                  commandId="org.sqldeps.dbeaver.commands.nextDiagnostic"
                  label="Next sqldeps Diagnostic"
                  style="push" />
            <command
                  commandId="org.sqldeps.dbeaver.commands.previousDiagnostic"
                  label="Previous sqldeps Diagnostic"
                  style="push" />
            <command
                  commandId="org.sqldeps.dbeaver.commands.selectIndex"
                  label="Select sqldeps Index..."
                  style="push" />
            <command
                  commandId="org.sqldeps.dbeaver.commands.automaticIndex"
                  label="Use Automatic sqldeps Index"
                  style="push" />
            <command
                  commandId="org.sqldeps.dbeaver.commands.reindex"
                  label="Reindex sqldeps Index"
                  style="push" />
            <command
                  commandId="org.sqldeps.dbeaver.commands.experimentalSuggestions"
                  label="Experimental Code Actions"
                  style="toggle" />
         </menu>
      </menuContribution>
      <menuContribution
            allPopups="false"
            locationURI="popup:org.jkiss.dbeaver.ui.editors.sql.SQLEditor.EditorContext?after=sql.extras">
         <menu id="org.sqldeps.dbeaver.sqlEditorContextMenu" label="sqldeps">
            <visibleWhen>
               <reference definitionId="org.sqldeps.dbeaver.sqlEditor" />
            </visibleWhen>
            <command
                  commandId="org.sqldeps.dbeaver.commands.analyzeSql"
                  label="Analyze SQL"
                  style="push" />
            <command
                  commandId="org.sqldeps.dbeaver.commands.codeActions"
                  label="Show All sqldeps Code Actions..."
                  style="push" />
            <command
                  commandId="org.sqldeps.dbeaver.commands.impact"
                  label="Show Impact of Changing Selected Object..."
                  style="push" />
            <command
                  commandId="org.sqldeps.dbeaver.commands.quickFixes"
                  label="Show sqldeps Quick Fixes..."
                  style="push" />
            <command
                  commandId="org.sqldeps.dbeaver.commands.diagnostics"
                  label="Show sqldeps Diagnostics"
                  style="push" />
            <command
                  commandId="org.sqldeps.dbeaver.commands.selectIndex"
                  label="Select sqldeps Index..."
                  style="push" />
            <command
                  commandId="org.sqldeps.dbeaver.commands.reindex"
                  label="Reindex sqldeps Index"
                  style="push" />
         </menu>
      </menuContribution>
   </extension>
</plugin>

