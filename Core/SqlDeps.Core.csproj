<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SqlDeps</RootNamespace>
    <AssemblyName>SqlDeps.Core</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="Properties/**/*.cs" />
    <Compile Include="../Domain/**/*.cs" Link="Domain/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../Analysis/**/*.cs" Link="Analysis/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../Indexing/**/*.cs" Link="Indexing/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../Storage/**/*.cs" Link="Storage/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="170.191.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
  </ItemGroup>

</Project>
