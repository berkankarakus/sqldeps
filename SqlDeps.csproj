<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>sqldeps</AssemblyName>
    <RootNamespace>SqlDeps</RootNamespace>
    <!-- Override with -p:ScriptDomVersion=<version> to use a locally packed ScriptDom build. -->
    <ScriptDomVersion Condition="'$(ScriptDomVersion)' == ''">170.191.0</ScriptDomVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs;Core/**/*.cs;Domain/**/*.cs;Analysis/**/*.cs;Indexing/**/*.cs;Storage/**/*.cs" />
    <ProjectReference Include="Core/SqlDeps.Core.csproj" />
    <ProjectReference Include="Storage/SqlDeps.Storage.csproj" />
  </ItemGroup>

</Project>
